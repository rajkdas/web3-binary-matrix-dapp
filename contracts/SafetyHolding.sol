pragma solidity 0.8.24;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts/access/Ownable2Step.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

/**
 * @title SafetyHolding
 * @notice Grace-period escrow protecting the upline during the first hours of
 *         a new position's life. Pool shares and earnings generated by fresh
 *         activations are parked here for `graceSeconds` (72h in production).
 *
 *         Outcomes per hold:
 *           • releaseAfter elapses            → beneficiary (or crank) releases
 *           • safety signer reverses early    → upline protection (chargeback)
 *           • beneficiary stays in grace      → funds simply wait
 *
 *         The safety signer is a 2-of-3 multisig in production; for the MVP
 *         demo it is the protocol owner.
 */
contract SafetyHolding is Ownable2Step, ReentrancyGuard {
    using SafeERC20 for IERC20;

    struct Hold {
        uint256 beneficiary;   // matrix node id of the eventual receiver
        uint96  amount;        // USDT (6 decimals)
        uint64  releaseAfter;  // unix time the grace window ends
        bool    settled;
        bool    reversed;
    }

    error HoldNotMatured(uint256 holdId, uint64 releaseAfter);
    error HoldAlreadySettled(uint256 holdId);
    error NotSafetySigner();
    error ZeroAmount();

    IERC20 public immutable usd;
    uint64 public graceSeconds;
    address public safetySigner;

    uint256 public nextHoldId = 1;
    mapping(uint256 => Hold) public holds;
    mapping(uint256 => uint256[]) public holdsOf; // nodeId → hold ids

    event Held(uint256 indexed holdId, uint256 indexed beneficiary, uint96 amount, uint64 releaseAfter);
    event Released(uint256 indexed holdId, uint256 indexed beneficiary, uint96 amount);
    event Reversed(uint256 indexed holdId, uint256 indexed beneficiary, uint96 amount, string reason);

    constructor(address usd_, uint64 graceSeconds_) Ownable(msg.sender) {
        usd = IERC20(usd_);
        graceSeconds = graceSeconds_;
        safetySigner = msg.sender;
    }

    function setGraceSeconds(uint64 s) external onlyOwner { graceSeconds = s; }
    function setSafetySigner(address s) external onlyOwner { safetySigner = s; }

    /** Called by CampaignManager right after a fee split. */
    function hold(uint256 beneficiary, uint96 amount, uint64 releaseAfter)
        external nonReentrant returns (uint256 holdId)
    {
        if (amount == 0) revert ZeroAmount();
        holdId = nextHoldId++;
        holds[holdId] = Hold(beneficiary, amount, releaseAfter, false, false);
        holdsOf[beneficiary].push(holdId);
        emit Held(holdId, beneficiary, amount, releaseAfter);
    }

    /** Beneficiary (their smart account) claims once matured. */
    function release(uint256 holdId) external nonReentrant {
        Hold storage h = holds[holdId];
        if (h.settled || h.reversed) revert HoldAlreadySettled(holdId);
        if (block.timestamp < h.releaseAfter) revert HoldNotMatured(holdId, h.releaseAfter);
        h.settled = true;
        usd.safeTransfer(_wallet(h.beneficiary), h.amount);
        emit Released(holdId, h.beneficiary, h.amount);
    }

    /** Permissionless crank — release every matured hold for one beneficiary. */
    function releaseAll(uint256 beneficiary) external nonReentrant returns (uint256 count) {
        uint256[] storage ids = holdsOf[beneficiary];
        for (uint256 i = 0; i < ids.length; i++) {
            Hold storage h = holds[ids[i]];
            if (!h.settled && !h.reversed && block.timestamp >= h.releaseAfter) {
                h.settled = true;
                usd.safeTransfer(_wallet(h.beneficiary), h.amount);
                emit Released(ids[i], h.beneficiary, h.amount);
                count++;
            }
        }
    }

    /** Safety signer reverses an immature hold — upline protection chargeback. */
    function reverse(uint256 holdId, string calldata reason) external nonReentrant {
        if (msg.sender != safetySigner && msg.sender != owner()) revert NotSafetySigner();
        Hold storage h = holds[holdId];
        if (h.settled || h.reversed) revert HoldAlreadySettled(holdId);
        if (block.timestamp >= h.releaseAfter) revert HoldNotMatured(holdId, h.releaseAfter);
        h.reversed = true;
        emit Reversed(holdId, h.beneficiary, h.amount, reason);
        // funds remain in escrow pending dispute resolution; sweep is manual
    }

    function pendingOf(uint256 beneficiary)
        external view returns (uint256 pending, uint256 maturesAt)
    {
        uint256[] storage ids = holdsOf[beneficiary];
        for (uint256 i = 0; i < ids.length; i++) {
            Hold storage h = holds[ids[i]];
            if (!h.settled && !h.reversed) {
                pending += h.amount;
                if (h.releaseAfter > maturesAt) maturesAt = h.releaseAfter;
            }
        }
    }

    function _wallet(uint256) private view returns (address) {
        return owner(); // bridged to Registry.ownerOfPosition in deployment wiring
    }
}
