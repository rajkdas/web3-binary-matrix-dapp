# PortaGraph needs NO environment variables to run — the SQLite database
# path is resolved automatically (Vercel → /tmp, local → ./db/custom.db).
#
# Optionally pin the database location explicitly (e.g. a managed SQLite
# volume on a VPS). When DATABASE_URL is set it is used verbatim:

# DATABASE_URL="file:/absolute/path/to/portagraph.db"

# Optional: URL of the realtime event-stream mini-service (local dev only).
# When absent, the API relays are skipped and the UI polls every 9 seconds.

# EVENT_STREAM_URL="http://127.0.0.1:3003"
